<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<%!
    public String getGrade(double avg) {
        if (avg >= 90)      return "A";
        else if (avg >= 80) return "B";
        else if (avg >= 70) return "C";
        else                return "F";
    }
%>
<%
    String[] names = {"김철수", "이영희", "박민수", "최지우", "정다은"};
    int[][] scores = {
        {90, 85, 100}, {78, 82, 69}, {55, 60, 48}, {88, 92, 95}, {70, 65, 80}
    };
    int[] subjectSum = new int[3];
%>
<h2>성적표</h2>
<table border="1">
    <tr>
        <th>이름</th><th>국어</th><th>영어</th><th>수학</th>
        <th>합계</th><th>평균</th><th>등급</th>
    </tr>
    <%
    for (int i = 0; i < names.length; i++) {
        int sum = 0;
        for (int j = 0; j < 3; j++) {
            sum += scores[i][j];
            subjectSum[j] += scores[i][j];
        }
        double avg = sum / 3.0;
    %>
    <tr style="background-color:<%= (avg < 60) ? "#ffcccc" : "#ffffff" %>">
        <td><%= names[i] %></td>
        <td><%= scores[i][0] %></td>
        <td><%= scores[i][1] %></td>
        <td><%= scores[i][2] %></td>
        <td><%= sum %></td>
        <td><%= String.format("%.1f", avg) %></td>
        <td><%= getGrade(avg) %></td>
    </tr>
    <% } %>
    <tr>
        <th>과목별 평균</th>
        <% for (int j = 0; j < 3; j++) { %>
        <td><%= String.format("%.1f", subjectSum[j] / (double) names.length) %></td>
        <% } %>
        <td colspan="3"></td>
    </tr>
</table>
</body>
</html>