<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
	<style>
	body {
		font-family: 'Malgun Gothic', sans-serif;
		background-color: #f4f6f8;
	}
	h2 {
		text-align: center;
		margin-top: 60px;
		color: #333;
	}
	.login-table {
		width: 400px;
		margin: 20px auto;
		border-collapse: collapse;
		background-color: #fff;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}
	.login-table td {
		padding: 12px;
		border: 1px solid #ddd;
	}
	.login-table .label {
		width: 150px;
		text-align: center;
		background-color: #f0f3f6;
		font-weight: bold;
	}
	.login-table input[type="text"],
	.login-table input[type="password"] {
		width: 90%;
		padding: 8px;
		border: 1px solid #ccc;
		border-radius: 4px;
	}
	.login-table input[type="text"]:focus,
	.login-table input[type="password"]:focus {
		outline: none;
		border-color: #4a90e2;
	}
	.login-table input[type="submit"] {
		width: 100%;
		padding: 10px;
		background-color: #4a90e2;
		color: #fff;
		border: none;
		border-radius: 4px;
		font-size: 16px;
		cursor: pointer;
	}
	.login-table input[type="submit"]:hover {
		background-color: #357abd;
	}
</style>
</head>
<body>
	<h2> 로그인 페이지 </h2>
	<!-- form안의 action은 이 페이지에서 작성한 정보를 떠넘겨주는 파일명을 기술하는 공간 -->
	<!-- 코드 한줄 복사 단축키 : Ctrl + Alt + ↓ -->
	<!-- form안의 method은 전송방식을 의미한다. (Get,  Post) -->
	<!-- form안의 전송버튼(submit)을 누르면 action의 RequestloginProc.jsp가 실행된다.  -->
	<!-- 웹에서 사용자로 부터 입력받은 정보는 암호화할수 있는 post방식을 사용한다.  
	     단, post는 URL에 값이 안 드러날 뿐 암호화는 아니다.
	-->
	<form action="RequestloginProcPw.jsp" method="post">
		<table width="400" border="1" class="login-table">
			<tr height="60">
				<td align="center" width="150" class="label">아이디</td>
				<td align="letf" width="250">
					<input type="text" name="id">
				</td>
			</tr>
			<tr height="60">
				<td align="center" width="150" class="label">패스워드</td>
				<td align="letf" width="250">
					<input type="password" name="pass">
				</td>
			</tr>
			<tr height="60">
				<td colspan="2" align="center" width="150">
					<input type="submit" value="전송">				
				</td>
			</tr>
		</table>
	</form>
</body>
</html>