<%@page import="java.security.MessageDigest"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<!-- 
	   PBKDF2 (포트폴리오 권장)

       SHA-256은 계산이 너무 빨라서 공격자가 초당 수십억 번 대입할 수 있어요. 
       PBKDF2는 일부러 반복 계산(수만 번) 해서 속도를 늦추는 방식이라 훨씬 안전합니다. 
       자바 기본 라이브러리에 들어 있어서 별도 설치도 필요 없어요.
	
	 -->
	 <%
	 	// 사용자의 정보가 저장되어있는 객체 request의 getParameter()를 이용하여 사용자의 정보를 추출
	 	// request.getParameter("Requestlogin.jsp파일의 id입력하는 input택으의 name을 작성한다.")
	 	String id = request.getParameter("id"); //사용장의 id값을 읽어들여서 변수 id에 저장하시오.
	 	String pass = request.getParameter("pass"); //사용장의 pass값을 읽어들여서 변수 pass에 저장하시오.
	 	
	 	//[방법1] 화면에 비밀번호길이 만큼 *로 가려서 보여주기
		String maskPw = "";
	 	for(int i=0; i<pass.length(); i++){
	 		maskPw += "*";
	 	}
	 	
	 	//[방법2] SHA-256 해시로 변환하기(되돌릴 수 없는 일방향 변환)
	 	MessageDigest md = MessageDigest.getInstance("SHA-256"); // 해시, 알고리즘 객체 생성
	 	byte[] hashBytes = md.digest(pass.getBytes("utf-8")); // 비밀번호흘 해시 값(byte 배열)로 변환
	 	
	 	StringBuilder sb = new StringBuilder();
	 	for(byte b : hashBytes){
	 		sb.append(String.format("%02x",b)); // byte를 16진수 문자열로 변환
	 	}
	 	String hashPw = sb.toString();
	 	
	 %>
	 <h2>당신의 아이디는 <%= id %>이고, 패스워드는 <%= maskPw %>입니다.</h2>
	 <h2>당신의 아이디는 <%= id %>이고, 패스워드는 <%= hashPw %>입니다.</h2>
</body>
</html>