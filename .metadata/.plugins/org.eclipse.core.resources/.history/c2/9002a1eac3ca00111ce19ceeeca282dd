<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<%
	   request.setCharacterEncoding("utf-8");
	
	   String coffee = request.getParameter("coffee");
	   int price = 0;
	   
	   if(coffee.equals("아메리카노")){
		   price = 3000;   
	   }else if(coffee.equals("카페라떼")){
		   price = 3300;
	   }else if(coffee.equals("에스프레소")){
		   price = 2500;
	   }else{
		   price = 3500;
	   }
	   
	   /* 네, 맞아요. Integer.parseInt()를 써야 해요.
          request.getParameter()는 항상 String을 반환해서, 폼에서 숫자를 입력해도 문자열로 넘어와요. 
          그래서 int에 바로 대입하면 컴파일 오류가 나요. */
	   
	   int quantity =Integer.parseInt(request.getParameter("quantity")) ;
	   int money = Integer.parseInt(request.getParameter("money"));
	   int total = 0;
	   total = quantity * money;
	%>
	
	<h2>주문계산 결과</h2>
	<ul>
		<li>커피종류 : <%= coffee %></li>
		<li>1개 가격 : <%= price %></li>
		<li>수량 : <%= quantity %></li>
		<li>총금액 : <%= total %></li>
		<li>입급액 : <%= money %></li>
		<li>거스름돈 : <%= money - total %></li>
	</ul>
</body>
</html>